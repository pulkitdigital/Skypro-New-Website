# Google Apps Script web-app URL that receives the enquiry form (form-encoded POST).
# Leave empty to test locally: the payload is logged to the console and the success state is shown.
NEXT_PUBLIC_FORM_ENDPOINT=

# Optional analytics — scripts load only when a value is set.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
# Meta Pixel ID currently used on the live WordPress site: 2735375403482238

# Used for canonical/OG URLs.
NEXT_PUBLIC_SITE_URL=https://skyproaviation.org
