{
  "name": "skypro-aviation-homepage",
  "version": "1.0.0",
  "private": true,
  "description": "SkyPro Aviation homepage — Next.js 15 static export",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start:static": "serve out -l 4173",
    "lint": "eslint . && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "media:download": "python -I scripts/media/download.py scripts/media/manifest.json .media-cache",
    "media:images": "node scripts/media/convert-images.mjs scripts/media/manifest.json .media-cache public/media",
    "media:video": "bash scripts/media/convert-videos.sh node_modules/ffmpeg-static/ffmpeg.exe .media-cache public/media",
    "media:extras": "node scripts/media/derived-assets.mjs",
    "qa:grep": "node scripts/qa/grep-banned.mjs",
    "qa:content": "node scripts/qa/check-content.mjs",
    "qa:jump": "node scripts/qa/jump-trace.mjs",
    "screenshots": "node scripts/qa/screenshots.mjs",
    "test:e2e": "playwright test",
    "package": "python -I scripts/deploy/package.py out deploy"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "@hookform/resolvers": "5.9.1",
    "@phosphor-icons/react": "2.1.10",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "embla-carousel-react": "8.6.0",
    "gsap": "3.15.0",
    "lenis": "1.3.27",
    "motion": "14.3.0",
    "next": "15.5.28",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.28",
    "ffmpeg-static": "5.3.0",
    "postcss": "8.5.30",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "serve": "14.2.6",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3"
  }
}
